<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_drive"
        android:shortcutId="driving_mode"
        android:shortcutLongLabel="@string/sc_drive_long"
        android:shortcutShortLabel="@string/sc_drive">
