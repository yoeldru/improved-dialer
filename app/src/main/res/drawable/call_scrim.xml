<!-- נכתב: 2026-11-05 19:05 (שעון ישראל) — חייגן משופר: הצללה מעל תמונת הרקע כדי שהכיתוב יהיה קריא -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#00000000"
                android:centerY="0.35"
                android:endColor="#00000000"
                android:startColor="#B3000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#4D000000"
                android:centerY="0.35"
                android:endColor="#00000000"
                android:startColor="#D9000000" />
        </shape>
    </item>
</layer-list>
