<?xml version="1.0" encoding="utf-8"?>
<!-- נכתב: 2026-11-01 10:50 (שעון ישראל) — חייגן משופר: מסך שיחה (נכנסת / פעילה) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <FrameLayout
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_marginTop="36dp">

        <TextView
            android:id="@+id/initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/circle"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="52sp"
            android:textStyle="bold" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/CircleImage" />
    </FrameLayout>

    <TextView
        android:id="@+id/callName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@android:color/white"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/callNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#CCFFFFFF"
        android:textDirection="ltr"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/callStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#AAFFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/callExtra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFC107"
        android:textSize="15sp"
        android:visibility="gone" />

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- שיחה נכנסת -->
    <LinearLayout
        android:id="@+id/incomingPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRejectWa"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="דחה + וואטסאפ"
                android:textColor="@android:color/white"
                app:backgroundTint="#FF128C4A" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRejectSms"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="דחה + SMS"
                android:textColor="@android:color/white"
                app:backgroundTint="#FF37474F" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnReject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="דחה"
                    app:backgroundTint="@color/end_red"
                    app:fabCustomSize="76dp"
                    app:maxImageSize="36dp"
                    app:srcCompat="@drawable/ic_call_end"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="דחה"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnAnswer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="ענה"
                    app:backgroundTint="@color/call_green"
                    app:fabCustomSize="76dp"
                    app:maxImageSize="36dp"
                    app:srcCompat="@drawable/ic_call"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="ענה"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- שיחה פעילה -->
    <LinearLayout
        android:id="@+id/ongoingPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/dtmfKeypad"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layoutDirection="ltr"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- עודכן: 2026-11-01 22:40 — שמע (רמקול/טלפון/בלוטות'), הוספת שיחה, מיזוג, הקלטה -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMute"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="🎤\nהשתק"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#55FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeaker"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="🔈\nרמקול"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#55FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeypad"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="⌨\nמקלדת"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#55FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHold"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="⏸\nהמתנה"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#55FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddCall"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="➕\nהוסף שיחה"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#55FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecord"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="⏺\nהקלט"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#55FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwap"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="⇄ החלף"
                android:textColor="@android:color/white"
                android:visibility="gone"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMerge"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="⧉ מזג שיחות"
                android:textColor="@android:color/white"
                android:visibility="gone"
                app:backgroundTint="#FF1B8A5A"
                app:cornerRadius="18dp" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnHangup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="נתק"
            app:backgroundTint="@color/end_red"
            app:fabCustomSize="76dp"
            app:maxImageSize="36dp"
            app:srcCompat="@drawable/ic_call_end"
            app:tint="@android:color/white" />
    </LinearLayout>
</LinearLayout>
