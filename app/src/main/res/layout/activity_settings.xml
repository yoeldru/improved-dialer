<?xml version="1.0" encoding="utf-8"?>
<!-- נכתב: 2026-11-01 10:50 (שעון ישראל) — חייגן משופר: הגדרות -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="הגדרות"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🔴 עדכון זמין — עדכן עכשיו"
            android:textColor="@android:color/white"
            android:visibility="gone"
            app:backgroundTint="#FFE53935" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckUpdate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="בדוק אם יש עדכון" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareApp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📤 שתף את האפליקציה עם אחרים" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="הגדר כחייגן ברירת מחדל" />

        <TextView
            android:id="@+id/defaultStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="הודעות מהירות לדחיית שיחה"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="כל שורה = הודעה אחת. משמשות לדחייה עם וואטסאפ ועם SMS."
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="שמור הודעות" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBlocked"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="מספרים חסומים" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAppSettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="הרשאות האפליקציה" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:alpha="0.6"
            android:gravity="center"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
